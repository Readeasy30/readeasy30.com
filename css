body {
    background-color: #fdfdfd; 
    color: #333333;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    margin: 0;
    padding: 0;
    line-height: 1.6;
    text-align: center;
}

header {
    background-color: #e0f2f1;
    padding: 40px 20px;
    border-bottom: 3px solid #b2dfdb;
}

h1 {
    font-size: 3rem;
    margin: 0;
    color: #00796b;
}

#bubbles-container {
    margin: 50px auto;
    padding: 20px;
    max-width: 400px;
    background: white;
    border-radius: 50px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
}

button {
    background-color: #ffd700;
    color: #444;
    border: none;
    padding: 25px 50px;
    font-size: 1.8rem;
    font-weight: bold;
    border-radius: 20px;
    cursor: pointer;
    transition: transform 0.2s ease;
    box-shadow: 0 6px #b8860b;
}

button:hover {
    transform: scale(1.05);
}

button:active {
    box-shadow: 0 2px #b8860b;
    transform: translateY(4px);
}

.day-circle {
    width: 60px;
    height: 60px;
    background-color: #f0f0f0;
    border: 2px solid #ddd;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    color: #999;
    font-size: 1.2rem;
    margin: 5px;
}
:root {
  --bg-color: #fdfdfd; /* Soft white to prevent glare */
  --text-color: #2c3e50;
  --accent-color: #3498db; /* Bubbles Blue */
  --highlight-color: #fff176; /* Gentle yellow for the rainbow trail */
}

body {
  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  font-size: 24px; /* Large for easy tracking */
  line-height: 1.6;
  background-color: var(--bg-color);
  padding: 20px;
}

#reading-area {
  max-width: 800px;
  margin: 50px auto;
  padding: 40px;
  border: 4px solid var(--accent-color);
  border-radius: 25px; /* Rounded edges are friendlier */
  background: white;
}

.word-highlight {
  background-color: var(--highlight-color);
  border-radius: 4px;
  transition: background 0.3s ease;
}

/* Bubbles Container */
#bubbles-container {
  position: fixed;
  bottom: 30px;
  right: 30px;
  text-align: center;
}
