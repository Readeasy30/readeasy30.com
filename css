/* --- 1. CORE ACCESSIBILITY SETTINGS --- */
:root {
  --bg-color: #fdfdfd;       /* Off-white to prevent glare/eye strain */
  --text-color: #333333;
  --bubbles-blue: #3498db;   /* Friendly blue */
  --gold-reward: #ffd700;    /* For buttons and success */
  --highlight: #fff176;      /* Soft yellow for word tracking */
}

body {
  background-color: var(--bg-color);
  color: var(--text-color);
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  font-size: 24px;           /* Large base font for readability */
  line-height: 1.6;
  margin: 0;
  padding: 0;
  text-align: center;
}

/* --- 2. HEADER & LAYOUT --- */
header {
  background-color: #e0f2f1;
  padding: 40px 20px;
  border-bottom: 3px solid #b2dfdb;
}

h1 {
  font-size: 3.5rem;
  margin: 0;
  color: #00796b;
}

/* --- 3. THE READING ZONE --- */
#reading-area {
  max-width: 800px;
  margin: 40px auto;
  padding: 40px;
  border: 5px solid var(--bubbles-blue);
  border-radius: 30px;
  background: white;
  box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}

.word-highlight {
  background-color: var(--highlight);
  border-radius: 4px;
  transition: background 0.3s ease;
}

/* --- 4. BUBBLES & INTERACTION --- */
#bubbles-avatar {
  display: inline-block;
  cursor: pointer;
}

button {
  background-color: var(--gold-reward);
  color: #444;
  border: none;
  padding: 25px 50px;
  font-size: 1.8rem;
  font-weight: bold;
  border-radius: 25px;
  cursor: pointer;
  transition: transform 0.2s ease;
  box-shadow: 0 6px #b8860b;
  margin-top: 20px;
}

button:hover { transform: scale(1.05); }
button:active {
  box-shadow: 0 2px #b8860b;
  transform: translateY(4px);
}

/* --- 5. THE HERO JOURNEY (Progress Dots) --- */
#heroes-board {
  margin-top: 50px;
  padding: 30px;
  background: #f0f8ff;
  border-radius: 20px;
}

.day-circle {
  width: 60px;
  height: 60px;
  background-color: #ffffff;
  border: 2px solid #ddd;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  color: #999;
  font-size: 1.2rem;
  margin: 8px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}

.day-active {
  background-color: var(--gold-reward);
  border-color: #ffa500;
  color: #444;
  box-shadow: 0 0 15px rgba(255, 215, 0, 0.5);
}
.verb-highlight {
    color: #e67e22; /* A nice orange for action */
    font-weight: bold;
    text-decoration: underline;
}




 

